{
  "name": "frappe-ui-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/assets/frappe_webportals/frontend/ && yarn copy-html-entry",
    "preview": "vite preview",
    "copy-html-entry": "mkdir -p ../frappe_webportals/www && cp ../frappe_webportals/public/frontend/index.html ../frappe_webportals/www/frontend.html"
  },
  "dependencies": {
    "feather-icons": "^4.29.2",
    "frappe-ui": "^0.1.278",
    "vue": "^3.5.42",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "postcss-nesting": "^14.0.1",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.0"
  }
}
